# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
DB_READINESS_TIMEOUT_MS=10000
LOG_LEVEL=info

# Neon PostgreSQL
# Use the pooled URL for application traffic and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require&connect_timeout=15
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require&connect_timeout=15
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require&connect_timeout=15

# HTTP security
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

# Cloudflare R2 (used in the media phase)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# SMTP (used in the notification/email phase)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
