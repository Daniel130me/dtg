# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
DB_READINESS_TIMEOUT_MS=10000
LOG_LEVEL=info
RELEASE_ID=
METRICS_ENABLED=true

# Neon PostgreSQL
# Use the pooled URL for application traffic and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require&connect_timeout=15
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require&connect_timeout=15
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require&connect_timeout=15

# HTTP security
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
# Preferred over the legacy boolean: none, cloudflare, render, or cloud-run.
TRUSTED_PROXY_PROVIDER=none
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2
R2_BUCKET=
# S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
# Public Worker/custom-domain URL used to display uploaded objects.
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# SMTP (used in the notification/email phase)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Payments (configure both values together when paid courses are enabled)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# One-time owner bootstrap (remove after provisioning)
ALLOW_OWNER_BOOTSTRAP=false
OWNER_EMAIL=
OWNER_DISPLAY_NAME=
OWNER_PASSWORD=
