// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  OWNER
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  REVOKED
}

enum EnrolmentSource {
  FREE
  PURCHASE
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(120)
  email           String            @unique @db.VarChar(320)
  emailNormalized String            @unique @db.VarChar(320)
  emailVerified   Boolean           @default(false)
  image           String?           @db.VarChar(2048)
  role            UserRole          @default(STUDENT)
  status          UserStatus        @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  profile         Profile?
  accounts        Account[]
  sessions        Session[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  ownedPlatform   PlatformSettings? @relation("PlatformOwner")
  createdCourses    Course[]            @relation("CourseCreator")
  enrolments        Enrolment[]
  orders            Order[]
  lessonProgress    LessonProgress[]
  lessonNotes       LessonNote[]
  discussionThreads DiscussionThread[]
  discussionPosts   DiscussionPost[]

  @@index([status, createdAt, id])
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(120)
  countryCode String?  @db.VarChar(2)
  bio         String?  @db.VarChar(1000)
  locale      String   @default("en") @db.VarChar(16)
  timezone    String   @default("UTC") @db.VarChar(64)
  avatarKey   String?  @db.VarChar(1024)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformSettings {
  id              String   @id @default("platform") @db.VarChar(32)
  ownerUserId     String   @unique @db.Uuid
  brandName       String   @default("DTG") @db.VarChar(120)
  defaultCurrency String   @default("USD") @db.VarChar(3)
  supportEmail    String?  @db.VarChar(320)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation("PlatformOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String    @db.VarChar(512)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.Uuid
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.VarChar(255)
  userId    String   @db.Uuid
  expiresAt DateTime
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(512)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(255)
  requestId   String?  @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt, id])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  scope          String            @db.VarChar(150)
  key            String            @db.VarChar(255)
  requestHash    String            @db.VarChar(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  expiresAt      DateTime

  @@unique([scope, key])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventKey      String?      @unique @db.VarChar(255)
  topic         String       @db.VarChar(150)
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(255)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt, id])
  @@index([aggregateType, aggregateId, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @db.VarChar(190)
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([expiresAt])
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique @db.VarChar(120)
  name      String         @db.VarChar(120)
  icon      String         @db.VarChar(60)
  status    CategoryStatus @default(ACTIVE)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  courses   Course[]

  @@index([status, sortOrder])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique @db.VarChar(160)
  title            String       @db.VarChar(200)
  shortDescription String       @db.VarChar(320)
  description      String       @db.VarChar(6000)
  thumbnailUrl     String?      @db.VarChar(2048)
  categoryId       String       @db.Uuid
  creatorUserId    String       @db.Uuid
  level            CourseLevel
  language         String       @default("English") @db.VarChar(32)
  // Money uses integer minor units; a zero price marks the course free.
  priceMinor       Int
  currency         String       @default("USD") @db.VarChar(3)
  status           CourseStatus @default(DRAFT)
  version          Int          @default(1)
  // Denormalized aggregates: course totals are maintained transactionally by
  // the authoring service; enrolment/rating counters are owned by their
  // respective phases and seeded only as deterministic demo data.
  totalSections    Int          @default(0)
  totalLessons     Int          @default(0)
  totalMinutes     Int          @default(0)
  enrollmentCount  Int          @default(0)
  ratingAverage    Decimal?     @db.Decimal(3, 2)
  ratingCount      Int          @default(0)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  category     Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator      User                @relation("CourseCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  sections     CourseSection[]
  requirements CourseRequirement[]
  outcomes     CourseOutcome[]
  enrolments      Enrolment[]
  orderItems      OrderItem[]
  lessonProgress  LessonProgress[]
  lessonNotes     LessonNote[]
  discussions     DiscussionThread[]

  @@index([status, publishedAt, id])
  @@index([categoryId, status])
  @@index([status, updatedAt, id])
  @@index([creatorUserId, status, updatedAt])
}

model CourseSection {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  title     String   @db.VarChar(200)
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, position])
  @@index([courseId, createdAt])
}

model Lesson {
  id              String       @id @default(uuid()) @db.Uuid
  sectionId       String       @db.Uuid
  // courseId is denormalized from the section to power unique position
  // constraints and access checks without joining through sections.
  courseId        String       @db.Uuid
  title           String       @db.VarChar(200)
  type            LessonType
  status          LessonStatus @default(DRAFT)
  position        Int
  durationSeconds Int          @default(0)
  isPreview       Boolean      @default(false)
  // Text-lesson body (Markdown). Video lessons reference media in a later phase.
  content         String?      @db.VarChar(20000)
  videoUrl        String?      @db.VarChar(2048)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  progress LessonProgress[]
  notes    LessonNote[]
  threads  DiscussionThread[]

  @@unique([sectionId, position])
  @@index([courseId, status, position])
  @@index([sectionId, createdAt])
}

model CourseRequirement {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  position Int
  text     String @db.VarChar(300)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
}

model CourseOutcome {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  position Int
  text     String @db.VarChar(300)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
}

// ---------------------------------------------------------------------------
// Commerce and enrolment
//
// Money is always integer minor units with an explicit currency. Provider
// references are nullable VarChars (never enums) so adopting a payment
// provider never requires a migration, and (provider, providerRef) is unique
// everywhere so provider events can be replayed safely.
// ---------------------------------------------------------------------------

model Enrolment {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  courseId     String          @db.Uuid
  status       EnrolmentStatus @default(ACTIVE)
  // How the learner got in: free enrolment, a paid order, or an owner grant.
  source       EnrolmentSource @default(FREE)
  // Set when source = PURCHASE; links the access to the paid order line.
  // Unique: one purchase line produces at most one enrolment.
  orderItemId  String?         @unique @db.Uuid
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  revokedAt    DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  // The enrolment idempotency guarantee: one row per learner per course.
  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([userId, status, createdAt])
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  status      OrderStatus @default(PENDING)
  currency    String      @db.VarChar(3)
  totalMinor  Int
  provider    String?     @db.VarChar(64)
  providerRef String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@unique([provider, providerRef])
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  courseId       String   @db.Uuid
  // Server-owned price snapshot taken at checkout time; client prices are
  // never trusted.
  unitPriceMinor Int
  currency       String   @db.VarChar(3)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrolment  Enrolment?

  @@unique([orderId, courseId])
  @@index([courseId])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  provider    String        @db.VarChar(64)
  providerRef String?       @db.VarChar(255)
  status      PaymentStatus @default(PENDING)
  amountMinor Int
  currency    String        @db.VarChar(3)
  // Raw provider payload for reconciliation after the fact.
  payload     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@unique([provider, providerRef])
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @db.Uuid
  provider    String       @db.VarChar(64)
  providerRef String?      @db.VarChar(255)
  status      RefundStatus @default(PENDING)
  amountMinor Int
  currency    String       @db.VarChar(3)
  reason      String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@unique([provider, providerRef])
}

model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  provider    String             @db.VarChar(64)
  providerRef String             @db.VarChar(255)
  topic       String             @db.VarChar(100)
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  lastError   String?            @db.Text

  @@unique([provider, providerRef])
  @@index([status, receivedAt])
}

// ---------------------------------------------------------------------------
// Learner state (Phase 8): durable progress, private notes, lesson Q&A.
//
// courseId is denormalized onto every learner-state row so dashboards and
// progress percentages aggregate per course without joining through lessons.
// Moderation is a plain status enum shared by threads and posts: a HIDDEN row
// stays in the database for the audit trail but is excluded from learner reads.
// ---------------------------------------------------------------------------

enum DiscussionStatus {
  ACTIVE
  HIDDEN
}

/// One row per completed lesson per learner. The row itself is the completion
/// (monotonic: completions never regress), so repeats are idempotent via the
/// unique constraint.
model LessonProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  lessonId    String   @db.Uuid
  // Denormalized from the lesson for per-course aggregation.
  courseId    String   @db.Uuid
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId, completedAt])
  @@index([courseId])
}

/// One private, editable note per learner per lesson.
model LessonNote {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  lessonId String   @db.Uuid
  // Denormalized from the lesson for the all-notes export.
  courseId String   @db.Uuid
  body     String   @db.VarChar(5000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
}

/// A learner question on a lesson; replies live in DiscussionPost.
model DiscussionThread {
  id             String           @id @default(uuid()) @db.Uuid
  lessonId       String           @db.Uuid
  // Denormalized for per-course moderation reads.
  courseId       String           @db.Uuid
  userId         String           @db.Uuid
  title          String           @db.VarChar(200)
  status         DiscussionStatus @default(ACTIVE)
  // Denormalized reply count maintained transactionally by the replies service.
  postCount      Int              @default(0)
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts  DiscussionPost[]

  @@index([lessonId, status, lastActivityAt])
  @@index([courseId, status, lastActivityAt])
}

/// A reply (or follow-up) inside a discussion thread.
model DiscussionPost {
  id        String           @id @default(uuid()) @db.Uuid
  threadId  String           @db.Uuid
  userId    String           @db.Uuid
  body      String           @db.VarChar(5000)
  status    DiscussionStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, status, createdAt])
}
