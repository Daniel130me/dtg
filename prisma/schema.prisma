// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  OWNER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  REVOKED
}

enum EnrolmentSource {
  FREE
  PURCHASE
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String                 @db.VarChar(120)
  email                 String                 @unique @db.VarChar(320)
  emailNormalized       String                 @unique @db.VarChar(320)
  emailVerified         Boolean                @default(false)
  image                 String?                @db.VarChar(2048)
  role                  UserRole               @default(STUDENT)
  status                UserStatus             @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  profile               Profile?
  accounts              Account[]
  sessions              Session[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  ownedPlatform         PlatformSettings?      @relation("PlatformOwner")
  createdCourses        Course[]               @relation("CourseCreator")
  enrolments            Enrolment[]
  orders                Order[]
  lessonProgress        LessonProgress[]
  lessonNotes           LessonNote[]
  discussionThreads     DiscussionThread[]
  discussionPosts       DiscussionPost[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  gradesGiven           AssignmentGrade[]      @relation("AssignmentGrader")
  certificates          Certificate[]
  reviews               Review[]
  notifications         Notification[]
  reviewRepliesGiven    Review[]               @relation("ReviewReplier")
  exportJobsRequested   ExportJob[]            @relation("ExportRequester")

  @@index([status, createdAt, id])
}

model Profile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  displayName       String   @db.VarChar(120)
  countryCode       String?  @db.VarChar(2)
  bio               String?  @db.VarChar(1000)
  locale            String   @default("en") @db.VarChar(16)
  timezone          String   @default("UTC") @db.VarChar(64)
  avatarKey         String?  @db.VarChar(1024)
  // Per-user notification toggles (emailNotifications/courseUpdates/newContent/
  // promotionalEmails). Nullable on purpose: null reads as the contract defaults
  // so pre-existing rows keep their behaviour without a backfill.
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformSettings {
  id              String   @id @default("platform") @db.VarChar(32)
  ownerUserId     String   @unique @db.Uuid
  brandName       String   @default("DTG") @db.VarChar(120)
  defaultCurrency String   @default("NGN") @db.VarChar(3)
  supportEmail    String?  @db.VarChar(320)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation("PlatformOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String    @db.VarChar(512)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.Uuid
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.VarChar(255)
  userId    String   @db.Uuid
  expiresAt DateTime
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(512)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(255)
  requestId   String?  @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt, id])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  scope          String            @db.VarChar(150)
  key            String            @db.VarChar(255)
  requestHash    String            @db.VarChar(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  expiresAt      DateTime

  @@unique([scope, key])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventKey      String?      @unique @db.VarChar(255)
  topic         String       @db.VarChar(150)
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(255)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt, id])
  @@index([aggregateType, aggregateId, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @db.VarChar(190)
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([expiresAt])
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique @db.VarChar(120)
  name      String         @db.VarChar(120)
  icon      String         @db.VarChar(60)
  status    CategoryStatus @default(ACTIVE)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  courses   Course[]

  @@index([status, sortOrder])
}

model CourseLevelOption {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, name])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique @db.VarChar(160)
  title            String       @db.VarChar(200)
  shortDescription String       @db.VarChar(320)
  description      String       @db.VarChar(6000)
  thumbnailUrl     String?      @db.VarChar(2048)
  // Provider-neutral object key is retained separately from the delivery URL
  // so media can be migrated without changing the authoring contract.
  thumbnailKey     String?      @db.VarChar(512)
  promoVideoUrl    String?      @db.VarChar(2048)
  categoryId       String       @db.Uuid
  creatorUserId    String       @db.Uuid
  level            String       @db.VarChar(80)
  language         String       @default("English") @db.VarChar(32)
  // Money uses integer minor units; a zero price marks the course free.
  priceMinor       Int
  currency         String       @default("NGN") @db.VarChar(3)
  status           CourseStatus @default(DRAFT)
  version          Int          @default(1)
  // Denormalized aggregates: course totals are maintained transactionally by
  // the authoring service; enrolment/rating counters are owned by their
  // respective phases and seeded only as deterministic demo data.
  totalSections    Int          @default(0)
  totalLessons     Int          @default(0)
  totalMinutes     Int          @default(0)
  enrollmentCount  Int          @default(0)
  ratingAverage    Decimal?     @db.Decimal(3, 2)
  ratingCount      Int          @default(0)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator        User                @relation("CourseCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  sections       CourseSection[]
  requirements   CourseRequirement[]
  outcomes       CourseOutcome[]
  enrolments     Enrolment[]
  orderItems     OrderItem[]
  lessonProgress LessonProgress[]
  lessonNotes    LessonNote[]
  discussions    DiscussionThread[]
  quizzes        Quiz[]
  assignments    Assignment[]
  certificates   Certificate[]
  reviews        Review[]

  @@index([status, publishedAt, id])
  @@index([categoryId, status])
  @@index([status, updatedAt, id])
  @@index([creatorUserId, status, updatedAt])
}

model CourseSection {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  title     String   @db.VarChar(200)
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, position])
  @@index([courseId, createdAt])
}

model Lesson {
  id               String       @id @default(uuid()) @db.Uuid
  sectionId        String       @db.Uuid
  // courseId is denormalized from the section to power unique position
  // constraints and access checks without joining through sections.
  courseId         String       @db.Uuid
  title            String       @db.VarChar(200)
  type             LessonType
  status           LessonStatus @default(DRAFT)
  position         Int
  durationSeconds  Int          @default(0)
  isPreview        Boolean      @default(false)
  // Text-lesson body (Markdown). `videoUrl` remains for backwards-compatible
  // external media; uploaded lectures use the private R2 object metadata below.
  content          String?      @db.VarChar(20000)
  videoUrl         String?      @db.VarChar(2048)
  videoKey         String?      @db.VarChar(512)
  videoFileName    String?      @db.VarChar(255)
  videoContentType String?      @db.VarChar(100)
  videoSizeBytes   BigInt?
  videoUploadedAt  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  progress   LessonProgress[]
  notes      LessonNote[]
  threads    DiscussionThread[]
  quiz       Quiz?
  assignment Assignment?

  @@unique([sectionId, position])
  @@index([courseId, status, position])
  @@index([sectionId, createdAt])
}

model CourseRequirement {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  position Int
  text     String @db.VarChar(300)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
}

model CourseOutcome {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  position Int
  text     String @db.VarChar(300)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
}

// ---------------------------------------------------------------------------
// Commerce and enrolment
//
// Money is always integer minor units with an explicit currency. Provider
// references are nullable VarChars (never enums) so adopting a payment
// provider never requires a migration, and (provider, providerRef) is unique
// everywhere so provider events can be replayed safely.
// ---------------------------------------------------------------------------

model Enrolment {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  courseId    String          @db.Uuid
  status      EnrolmentStatus @default(ACTIVE)
  // How the learner got in: free enrolment, a paid order, or an owner grant.
  source      EnrolmentSource @default(FREE)
  // Set when source = PURCHASE; links the access to the paid order line.
  // Unique: one purchase line produces at most one enrolment.
  orderItemId String?         @unique @db.Uuid
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  revokedAt   DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  // The enrolment idempotency guarantee: one row per learner per course.
  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([userId, status, createdAt])
  // Serves the owner analytics monthly enrolment trend (status != REVOKED
  // bucketed by createdAt month); see docs/ANALYTICS_METRICS.md.
  @@index([status, createdAt])
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  status      OrderStatus @default(PENDING)
  currency    String      @db.VarChar(3)
  totalMinor  Int
  provider    String?     @db.VarChar(64)
  providerRef String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @db.Uuid
  courseId       String @db.Uuid
  // Server-owned price snapshot taken at checkout time; client prices are
  // never trusted.
  unitPriceMinor Int
  currency       String @db.VarChar(3)

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrolment Enrolment?

  @@unique([orderId, courseId])
  @@index([courseId])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  provider    String        @db.VarChar(64)
  providerRef String?       @db.VarChar(255)
  status      PaymentStatus @default(PENDING)
  amountMinor Int
  currency    String        @db.VarChar(3)
  // Raw provider payload for reconciliation after the fact.
  payload     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status, createdAt])
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @db.Uuid
  provider    String       @db.VarChar(64)
  providerRef String?      @db.VarChar(255)
  status      RefundStatus @default(PENDING)
  amountMinor Int
  currency    String       @db.VarChar(3)
  reason      String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([paymentId])
}

model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  provider    String             @db.VarChar(64)
  providerRef String             @db.VarChar(255)
  topic       String             @db.VarChar(100)
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  lastError   String?            @db.Text

  @@unique([provider, providerRef])
  @@index([status, receivedAt])
}

// ---------------------------------------------------------------------------
// Learner state (Phase 8): durable progress, private notes, lesson Q&A.
//
// courseId is denormalized onto every learner-state row so dashboards and
// progress percentages aggregate per course without joining through lessons.
// Moderation is a plain status enum shared by threads and posts: a HIDDEN row
// stays in the database for the audit trail but is excluded from learner reads.
// ---------------------------------------------------------------------------

enum DiscussionStatus {
  ACTIVE
  HIDDEN
}

/// One row per completed lesson per learner. The row itself is the completion
/// (monotonic: completions never regress), so repeats are idempotent via the
/// unique constraint.
model LessonProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  lessonId    String   @db.Uuid
  // Denormalized from the lesson for per-course aggregation.
  courseId    String   @db.Uuid
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId, completedAt])
  @@index([courseId])
}

/// One private, editable note per learner per lesson.
model LessonNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  lessonId  String   @db.Uuid
  // Denormalized from the lesson for the all-notes export.
  courseId  String   @db.Uuid
  body      String   @db.VarChar(5000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
}

/// A learner question on a lesson; replies live in DiscussionPost.
model DiscussionThread {
  id             String           @id @default(uuid()) @db.Uuid
  lessonId       String           @db.Uuid
  // Denormalized for per-course moderation reads.
  courseId       String           @db.Uuid
  userId         String           @db.Uuid
  title          String           @db.VarChar(200)
  status         DiscussionStatus @default(ACTIVE)
  // Denormalized reply count maintained transactionally by the replies service.
  postCount      Int              @default(0)
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lesson Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts  DiscussionPost[]

  @@index([lessonId, status, lastActivityAt])
  @@index([courseId, status, lastActivityAt])
}

/// A reply (or follow-up) inside a discussion thread.
model DiscussionPost {
  id        String           @id @default(uuid()) @db.Uuid
  threadId  String           @db.Uuid
  userId    String           @db.Uuid
  body      String           @db.VarChar(5000)
  status    DiscussionStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Assessments and credentials (Phase 9): quizzes, assignments, grading,
// certificates.
//
// Trust model: the answer key (QuizOption.isCorrect) lives server-side only
// and is never serialized into a learner DTO before the attempt is submitted
// (permitted review). Every attempt freezes a JSON snapshot of the exact
// questions/options it was served, so owner edits can never rewrite the
// meaning of an in-flight or graded attempt. Answer rows intentionally carry
// NO foreign keys into QuizQuestion/QuizOption: ids point into the attempt's
// snapshot, and replacing a quiz's authored content must never cascade-delete
// a learner's grading history.
//
// courseId is denormalized onto attempt/submission rows so canonical
// certificate eligibility ("every quiz passed, every assignment graded")
// aggregates per course without joining through lessons.
// ---------------------------------------------------------------------------

enum QuizAttemptStatus {
  STARTED
  SUBMITTED
  EXPIRED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

/// One authored quiz per QUIZ lesson. Editing replaces questions/options in a
/// transaction and bumps `version`; published attempts keep their snapshot.
model Quiz {
  id               String   @id @default(uuid()) @db.Uuid
  lessonId         String   @unique @db.Uuid
  // Denormalized from the lesson for per-course eligibility aggregation.
  courseId         String   @db.Uuid
  version          Int      @default(1)
  // Minimum percentage (0-100) the submitter must score to pass.
  passPercent      Int      @default(70)
  // Maximum attempts per learner; null means unlimited.
  maxAttempts      Int?
  // Hard submit deadline per attempt (startedAt + limit); null means untimed.
  timeLimitMinutes Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id          String  @id @default(uuid()) @db.Uuid
  quizId      String  @db.Uuid
  position    Int
  prompt      String  @db.VarChar(1000)
  points      Int     @default(1)
  // Shown to the learner only in post-submission review.
  explanation String? @db.VarChar(2000)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]

  @@unique([quizId, position])
  @@index([quizId])
}

model QuizOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  position   Int
  text       String  @db.VarChar(500)
  // Answer key. Server-side only: excluded from every pre-submission payload.
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@index([questionId])
}

/// One attempt per start. `questionSnapshot` freezes the served quiz (prompt,
/// points, explanation, options with the answer key) server-side; learners
/// answered exactly what the snapshot records.
model QuizAttempt {
  id               String            @id @default(uuid()) @db.Uuid
  quizId           String            @db.Uuid
  // Denormalized for per-course eligibility queries.
  courseId         String            @db.Uuid
  userId           String            @db.Uuid
  attemptNumber    Int
  status           QuizAttemptStatus @default(STARTED)
  // Immutable server-side snapshot of questions/options (incl. answer key).
  // Never serialized to the client as-is.
  questionSnapshot Json
  // Set from the quiz's time limit at start; late submissions are rejected.
  submitDeadline   DateTime?
  submittedAt      DateTime?
  scorePoints      Int?
  maxPoints        Int?
  scorePercent     Int?
  passed           Boolean?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, userId, attemptNumber])
  @@index([userId, courseId, status, passed])
  @@index([quizId, userId, status])
}

/// A per-question selection inside an attempt. questionId/optionId reference
/// the attempt's snapshot (plain strings, no FK by design — see the module
/// comment above).
model QuizAnswer {
  id         String  @id @default(uuid()) @db.Uuid
  attemptId  String  @db.Uuid
  questionId String  @db.VarChar(64)
  optionId   String? @db.VarChar(64)
  // Verdict frozen at submit time so later quiz edits never rewrite review.
  isCorrect  Boolean @default(false)

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

/// One assignment brief per ASSIGNMENT lesson.
model Assignment {
  id                String    @id @default(uuid()) @db.Uuid
  lessonId          String    @unique @db.Uuid
  // Denormalized from the lesson for per-course eligibility aggregation.
  courseId          String    @db.Uuid
  instructions      String    @db.VarChar(10000)
  maxPoints         Int       @default(100)
  // Hard deadline for new submissions; null means open-ended.
  dueAt             DateTime?
  // When false, exactly one submission is accepted per learner.
  allowResubmission Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id            String           @id @default(uuid()) @db.Uuid
  assignmentId  String           @db.Uuid
  // Denormalized for per-course eligibility queries.
  courseId      String           @db.Uuid
  userId        String           @db.Uuid
  attemptNumber Int
  status        SubmissionStatus @default(SUBMITTED)
  // Phase 9 deviation: the media module (Phase 5) is not built yet, so
  // submissions are text plus an optional external link. The column shape
  // keeps a verified MediaAsset reference drop-in for the media phase.
  body          String           @db.VarChar(20000)
  attachmentUrl String?          @db.VarChar(2048)
  submittedAt   DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignment Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  grades     AssignmentGrade[]

  @@unique([assignmentId, userId, attemptNumber])
  @@index([assignmentId, status, submittedAt])
  @@index([userId, courseId, status])
}

/// Grading history: every grade event appends a row; the latest row is the
/// learner-facing grade. Re-grading never rewrites history. maxPoints is
/// snapshotted at grade time so later brief edits cannot reinterpret a score.
model AssignmentGrade {
  id             String   @id @default(uuid()) @db.Uuid
  submissionId   String   @db.Uuid
  score          Int
  maxPoints      Int
  feedback       String?  @db.VarChar(5000)
  gradedByUserId String?  @db.Uuid
  createdAt      DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User?                @relation("AssignmentGrader", fields: [gradedByUserId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
}

/// Issued at most once per learner per course (`userId, courseId` unique);
/// `code` is the public high-entropy verification reference carrying no
/// personal information.
model Certificate {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique @db.VarChar(32)
  userId        String            @db.Uuid
  courseId      String            @db.Uuid
  status        CertificateStatus @default(ACTIVE)
  issuedAt      DateTime          @default(now())
  revokedAt     DateTime?
  revokedReason String?           @db.VarChar(500)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status, issuedAt])
}

// ---------------------------------------------------------------------------
// Engagement (Phase 10): verified course reviews, in-app notifications,
// transactional-email suppression, and support contact submissions.
//
// Trust model:
// - Reviews require a verified enrolment (ACTIVE or COMPLETED) at write time;
//   moderation is a status flip, never a delete, so owner history survives.
// - The Course.ratingAverage/ratingCount denormalized aggregates are owned by
//   the reviews service and recomputed transactionally from VISIBLE rows on
//   every create/update/moderate — moderation therefore always moves the
//   public rating consistently.
// - Notification rows are projected from committed OutboxEvents by the
//   dispatcher; dedupeKey ("<eventKey>:<userId>", unique) makes reprocessing
//   an event at-most-once per recipient.
// - EmailSuppression is the permanent "do not email" list consulted before
//   every transactional send; suppressed sends are completed no-ops, never
//   failures that roll back the user transaction that triggered them.
// - ContactSubmission bodies are purgeable PII: a retention sweep nulls the
//   message fields after CONTACT_RETENTION_DAYS (contract constant).
// ---------------------------------------------------------------------------

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

/// One review per learner per course. A learner may create/update/withdraw
/// their own review while enrolled; the owner moderates (HIDDEN) and replies.
model Review {
  id              String       @id @default(uuid()) @db.Uuid
  courseId        String       @db.Uuid
  userId          String       @db.Uuid
  rating          Int
  body            String       @db.VarChar(2000)
  status          ReviewStatus @default(VISIBLE)
  // Owner reply: a single updatable text attached to the review.
  reply           String?      @db.VarChar(2000)
  repliedAt       DateTime?
  repliedByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  replier User?  @relation("ReviewReplier", fields: [repliedByUserId], references: [id], onDelete: SetNull)

  @@unique([courseId, userId])
  @@index([courseId, status, createdAt, id])
  @@index([userId, updatedAt])
}

/// In-app notification. `readAt` null means unread; the learner owns their
/// rows and can only ever touch their own (userId-pinned queries).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  topic     String    @db.VarChar(100)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  linkPath  String?   @db.VarChar(500)
  // "<eventKey>:<userId>" for event-projected rows; unique -> idempotent replay.
  dedupeKey String?   @unique @db.VarChar(320)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt, id])
  @@index([userId, createdAt, id])
}

enum EmailSuppressionReason {
  BOUNCE
  COMPLAINT
  MANUAL
}

/// Permanent do-not-email list, checked before every transactional send.
model EmailSuppression {
  id        String                 @id @default(uuid()) @db.Uuid
  email     String                 @unique @db.VarChar(320)
  reason    EmailSuppressionReason
  detail    String?                @db.VarChar(500)
  createdAt DateTime               @default(now())
}

enum ContactStatus {
  NEW
  ARCHIVED
}

/// Public support contact submission. Spam controls live at the endpoint
/// (honeypot + rate limit); retention nulls the message fields after the
/// contract's CONTACT_RETENTION_DAYS while keeping the row for abuse counts.
model ContactSubmission {
  id        String        @id @default(uuid()) @db.Uuid
  name      String?       @db.VarChar(120)
  email     String?       @db.VarChar(320)
  subject   String?       @db.VarChar(200)
  message   String?       @db.VarChar(5000)
  status    ContactStatus @default(NEW)
  ipAddress String?       @db.VarChar(64)
  userAgent String?       @db.VarChar(512)
  createdAt DateTime      @default(now())
  purgedAt  DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Owner administration (Phase 11): async data exports.
//
// The generated CSV is stored bounded inside the row (EXPORT_MAX_ROWS caps
// the size) and delivered through the owner-only download endpoint. Deviation
// from the plan's "private R2 delivery": this environment has no object
// storage (Phase 5 R2 was not built); the DB blob + streaming endpoint
// preserves the private/expiring/audited semantics. EXPIRED jobs keep their
// metadata but never their content.
// ---------------------------------------------------------------------------

enum ExportType {
  ENROLMENTS
  STUDENTS
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model ExportJob {
  id                String          @id @default(uuid()) @db.Uuid
  requestedByUserId String          @db.Uuid
  type              ExportType
  status            ExportJobStatus @default(PENDING)
  filters           Json?
  rowCount          Int             @default(0)
  content           String?         @db.Text
  error             String?         @db.VarChar(500)
  expiresAt         DateTime?
  completedAt       DateTime?
  downloadCount     Int             @default(0)
  downloadedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  requestedBy User @relation("ExportRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([requestedByUserId, createdAt])
  @@index([status, expiresAt])
}
